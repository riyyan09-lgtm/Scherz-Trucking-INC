# Copy this file to .env.local and fill in real values before running locally.
# When deploying to Vercel, add these under Project Settings -> Environment Variables instead.

# Postgres connection string from your database provider (e.g. Supabase, Neon, RDS).
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/loadroute

# Optional, but recommended before you start running ads: get a free API key
# at resend.com, then set these two so you get emailed the moment a lead
# comes in. Leave blank and lead capture still works -- you just won't be
# notified.
RESEND_API_KEY=
NOTIFY_EMAIL=

# Supabase Auth (admin dashboard login). URL + anon key are safe to expose to
# the browser; access control comes from Supabase (public signups disabled)
# plus the ADMIN_EMAILS allowlist checked by /api/admin/stats.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated emails allowed into the admin dashboard. If empty, any
# authenticated Supabase user on this project is allowed.
ADMIN_EMAILS=

# Supabase service-role key (Project Settings -> API). SERVER-SIDE SECRET —
# never expose to the browser. Used by the admin Tenants panel to provision
# and remove tenant portal logins.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed site; used for canonical tags, Open Graph URLs,
# sitemap.xml, and robots.txt. Update when a custom domain is connected.
NEXT_PUBLIC_SITE_URL=https://scherz-trucking-app.vercel.app

# Set to "production" on Vercel; leave as "development" locally.
NODE_ENV=development
